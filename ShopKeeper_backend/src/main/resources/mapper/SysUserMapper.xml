<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.shopkeeper_backend.mapper.SysUserMapper">

    <sql id="baseColumns">
        user_id, username, real_name, gender, status
    </sql>

    <!-- 登录查询（含密码密文） -->
    <select id="selectByUsername" resultType="org.example.shopkeeper_backend.entity.SysUser">
        SELECT user_id, username, password, real_name, gender, status
        FROM sys_user
        WHERE username = #{username}
    </select>

    <select id="count" resultType="long">
        SELECT COUNT(*)
        FROM sys_user
        <where>
            <if test="username != null and username != ''">
                AND username LIKE CONCAT('%', #{username}, '%')
            </if>
            <if test="realName != null and realName != ''">
                AND real_name LIKE CONCAT('%', #{realName}, '%')
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
    </select>

    <select id="selectPage" resultType="org.example.shopkeeper_backend.entity.SysUser">
        SELECT <include refid="baseColumns"/>
        FROM sys_user
        <where>
            <if test="username != null and username != ''">
                AND username LIKE CONCAT('%', #{username}, '%')
            </if>
            <if test="realName != null and realName != ''">
                AND real_name LIKE CONCAT('%', #{realName}, '%')
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
        ORDER BY user_id
        LIMIT #{offset}, #{size}
    </select>

    <select id="selectById" resultType="org.example.shopkeeper_backend.entity.SysUser">
        SELECT <include refid="baseColumns"/>
        FROM sys_user
        WHERE user_id = #{userId}
    </select>

    <insert id="insert" parameterType="org.example.shopkeeper_backend.entity.SysUser"
            useGeneratedKeys="true" keyProperty="userId">
        INSERT INTO sys_user (username, password, real_name, gender, status)
        VALUES (#{username}, #{password}, #{realName}, #{gender}, #{status})
    </insert>

    <update id="update" parameterType="org.example.shopkeeper_backend.entity.SysUser">
        UPDATE sys_user
        <set>
            <if test="username != null and username != ''">username = #{username},</if>
            <!-- 密码为空表示不修改；非空才更新 -->
            <if test="password != null and password != ''">password = #{password},</if>
            <if test="realName != null and realName != ''">real_name = #{realName},</if>
            <if test="gender != null and gender != ''">gender = #{gender},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        WHERE user_id = #{userId}
    </update>

    <delete id="deleteById">
        DELETE FROM sys_user WHERE user_id = #{userId}
    </delete>

</mapper>
