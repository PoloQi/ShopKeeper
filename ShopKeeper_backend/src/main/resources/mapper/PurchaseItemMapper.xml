<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.shopkeeper_backend.mapper.PurchaseItemMapper">

    <insert id="batchInsert">
        INSERT INTO purchase_item (po_no, product_id, quantity, unit_price, discount)
        VALUES
        <foreach collection="list" item="it" separator=",">
            (#{it.poNo}, #{it.productId}, #{it.quantity}, #{it.unitPrice}, #{it.discount})
        </foreach>
    </insert>

    <delete id="deleteByPoNo">
        DELETE FROM purchase_item WHERE po_no = #{poNo}
    </delete>

</mapper>
